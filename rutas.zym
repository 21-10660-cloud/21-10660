::zilly+

// Proyecto Final: Calculadora de Rutas en Tablero Reducido
// Funcion matematica recursiva: f(x,y) = f(x-1, y) + f(x, y-1)

Z => Z => Z rutas := fn(Z x) -> fn(Z y) -> 
    if(x < 1, 1, 
        if(y < 1, 1, 
            rutas(x - 1)(y) + rutas(x)(y - 1)
        )
    );

// Pruebas (indices empiezan en 0, un tablero 4x4 llega hasta el indice 3)
rutas(3)(3)
rutas(2)(2)
rutas(1)(4)
